APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# 必须大于等于所有 Job 中最大的 $timeout，否则任务会被重复执行
DB_QUEUE_RETRY_AFTER=180

# ---- 监控与告警（详见 DEPLOYMENT.md「自动化运维」章节）----
ERP_MONITOR_ENABLED=true
# 告警通道：站内消息 / 邮件 / 群机器人
ERP_ALERT_CHANNEL_DATABASE=true
ERP_ALERT_CHANNEL_MAIL=false
ERP_ALERT_CHANNEL_WEBHOOK=false
# 站内消息接收角色（逗号分隔）
ERP_ALERT_ROLES=admin
# 邮件收件人（逗号分隔，留空不发）
ERP_ALERT_MAIL_TO=
# 群机器人地址，driver 支持 wecom（企业微信）/ dingtalk（钉钉）/ feishu（飞书）
ERP_ALERT_WEBHOOK_URL=
ERP_ALERT_WEBHOOK_DRIVER=wecom
ERP_ALERT_WEBHOOK_SECRET=
# 同一告警冷却分钟数，以及冷却期内的升级触发次数
ERP_ALERT_COOLDOWN=30
ERP_ALERT_ESCALATION_AFTER=10

# ---- 数据库备份 ----
ERP_BACKUP_ENABLED=true
ERP_BACKUP_RETENTION_DAYS=14
# 找不到 mysqldump 时手工指定完整路径
ERP_MYSQLDUMP_PATH=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
