# 服务器生产环境 .env 模板（真实文件 deploy/docker/env.production 不入库）
# 使用：cp env.production.example /opt/erp/app/.env，然后填入 APP_KEY / DB_PASSWORD
# APP_KEY 生成：php artisan key:generate --show  或  php -r "echo 'base64:'.base64_encode(random_bytes(32));"
APP_NAME="Dedao ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://192.168.2.102

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_CN

APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=erp-db
DB_PORT=3306
DB_DATABASE=dedao_erp
DB_USERNAME=erp
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS=erp@dedao.local
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# 业务监控与自动状态转换（5 秒扫描任务）
ERP_MONITOR_ENABLED=true
ERP_STATE_TRANSITION_ENABLED=true
